# Plantilla de entorno. Copiar a .env.local y rellenar.
# .env.local está en .gitignore y nunca debe versionarse.

# --- PostgreSQL -------------------------------------------------------------
# Ninguno de los dos roles tiene BYPASSRLS. Es lo que hace que row level security
# sea una barrera real y no un adorno (docs/11 §1): en Supabase, `postgres` y
# `service_role` SÍ la evaden, así que no se usan desde la aplicación.
#
# El acceso directo (db.<ref>.supabase.co) no resuelve en IPv4: usar el pooler.

# Runtime. Rol bos_app: atiende todo lo que nace de una petición de usuario.
DATABASE_URL="postgresql://bos_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# Worker de outbox. Rol bos_publisher: sin privilegios de tabla, cruza tenants
# solo por el contrato de publicación de la migración 0008.
PUBLISHER_DATABASE_URL="postgresql://bos_publisher.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# Poner en "true" únicamente si una inspección TLS corporativa rompe la cadena
# de certificados. Deja rastro deliberado de que se relajó la verificación.
# DATABASE_SSL_NO_VERIFY="false"

# Conexiones máximas del pool de aplicación.
# DATABASE_POOL_MAX="10"

# --- Supabase Auth ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Eventos ----------------------------------------------------------------
# Valor del campo `source` en el envelope canónico (docs/06 §2).
BOS_EVENT_SOURCE="bos-core"

# --- Acceso de demostración -------------------------------------------------
# Un botón en el portal que entra sin escribir nada, como administrador del
# tenant `demo`.
#
# Conviene decirlo sin rodeos: es una cuenta de administrador cuya contraseña
# conoce cualquiera que tenga la URL. Encenderlo en un despliegue público es
# una decisión, no un ajuste. Lo que acota el daño es que esa cuenta administra
# el tenant `demo` y ningún otro: row level security la mantiene fuera de tus
# datos reales porque no tiene membresía en tu tenant.
#
# Apagado salvo que BOS_DEMO_ACCESS sea exactamente "true", y apagado también
# si falta la contraseña o tiene menos de 8 caracteres. No hay contraseña por
# defecto a propósito — una horneada en el repositorio sería igual de abierta
# pero idéntica en todos los despliegues.
#
# La contraseña NO lleva prefijo NEXT_PUBLIC_: nunca llega al navegador. El
# botón manda un formulario vacío y quien firma es el servidor.
#
# El primer clic crea la identidad y el tenant; los siguientes solo entran.
# Requiere que el proyecto de Supabase no exija confirmar el correo, o que
# alguien confirme esta cuenta una vez.
# BOS_DEMO_ACCESS="true"
# BOS_DEMO_EMAIL="demo@tudominio.com"
# BOS_DEMO_PASSWORD="<una contraseña larga y propia de este despliegue>"
